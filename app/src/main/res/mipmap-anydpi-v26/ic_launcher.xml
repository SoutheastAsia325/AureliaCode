<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标（API 26–32）。

  **刻意不含 <monochrome>**：该子标签是 API 33 才引入的。若把它写进 v26 资源，
  部分启动器在解析 v26 自适应图标时会因未知子标签整体加载失败，进而回退显示
  上一次安装缓存的旧图标 —— 这正是「换了图却还是旧图」的一种真实成因。
  主题化单色图标改由 mipmap-anydpi-v33/ic_launcher.xml 提供。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background" />
  <foreground android:drawable="@drawable/ic_launcher_foreground_inset" />
</adaptive-icon>
